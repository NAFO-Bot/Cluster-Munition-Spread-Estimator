import plotly.graph_objects as go
from IPython.display import HTML

def calculate_spread(angle, altitude):
    radians = (angle / 2) * 3.141592653589793 / 180
    return 2 * altitude * (0 if radians == 0 else (radians + radians**3/3 + 2*radians**5/15 + 17*radians**7/315 + 62*radians**9/2835)) # Taylor series for tan(x) for small x, otherwise use math.tan

# Angle data (5 to 85 degrees)
angle_data = list(range(5, 86, 1))

# Initial altitudes
current_altitude_init = 2000
comparison_altitude_init = 3000

# Calculate initial spread data
spread_data_init = [calculate_spread(angle, current_altitude_init) for angle in angle_data]
comparison_spread_data_init = [calculate_spread(angle, comparison_altitude_init) for angle in angle_data]

# Create Plotly figure
fig = go.Figure()

fig.add_trace(go.Scatter(
    x=angle_data,
    y=spread_data_init,
    mode='lines',
    name=f'Current Estimated Footprint (Altitude: {current_altitude_init}m)',
    line=dict(color='rgb(75, 192, 192)', width=2)
))

fig.add_trace(go.Scatter(
    x=angle_data,
    y=comparison_spread_data_init,
    mode='lines',
    name=f'Comparison Footprint (Altitude: {comparison_altitude_init}m)',
    line=dict(color='rgb(255, 99, 132)', width=2)
))

# Define slider steps for current altitude
current_altitude_slider_steps = []
for alt in range(500, 10001, 100):
    current_altitude_slider_steps.append({
        'method': 'restyle',
        'label': str(alt),
        'value': str(alt),
        'args': [
            {'y': [[calculate_spread(angle, alt) for angle in angle_data], fig.data[1].y]}, # Update only first trace's y
            {'name': [f'Current Estimated Footprint (Altitude: {alt}m)', fig.data[1].name]} # Update only first trace's name
        ]
    })

# Define slider steps for comparison altitude
comparison_altitude_slider_steps = []
for alt in range(500, 10001, 100):
    comparison_altitude_slider_steps.append({
        'method': 'restyle',
        'label': str(alt),
        'value': str(alt),
        'args': [
            {'y': [fig.data[0].y, [calculate_spread(angle, alt) for angle in angle_data]]}, # Update only second trace's y
            {'name': [fig.data[0].name, f'Comparison Footprint (Altitude: {alt}m)']} # Update only second trace's name
        ]
    })

fig.update_layout(
    title_text='Spread Estimator',
    xaxis_title='Total Dispersion Angle (degrees)',
    yaxis_title='Estimated Footprint Width (m)',
    hovermode='x unified',
    sliders=[
        {
            'steps': current_altitude_slider_steps,
            'active': (current_altitude_init - 500) // 100, # Set initial position
            'pad': {'t': 50},
            'currentvalue': {'prefix': 'Current Altitude: '},
            'len': 0.8, 'x': 0.1, 'y': 1.1, 'yanchor': 'bottom' # Moved to top
        },
        {
            'steps': comparison_altitude_slider_steps,
            'active': (comparison_altitude_init - 500) // 100, # Set initial position
            'pad': {'t': 50},
            'currentvalue': {'prefix': 'Comparison Altitude: '},
            'len': 0.8, 'x': 0.1, 'y': -0.1, 'yanchor': 'top' # Kept at bottom
        }
    ]
)

# Convert Plotly figure to HTML div
plotly_div_html = fig.to_html(full_html=False, include_plotlyjs='cdn')
